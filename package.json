{
  "name": "know-it-all",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev:web": "pnpm --filter know-all-web dev",
    "build:web": "pnpm --filter know-all-web build",
    "start:web": "pnpm --filter know-all-web start",
    "typecheck": "pnpm --filter know-all-web typecheck",
    "test:api": ".venv/bin/python -m pytest -q -m 'not postgres' apps/api/tests",
    "test:api:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql+psycopg://koham@127.0.0.1:5432/know_it_all_test} DATABASE_URL=${TEST_DATABASE_URL:-postgresql+psycopg://koham@127.0.0.1:5432/know_it_all_test} .venv/bin/python -m pytest -q -m postgres apps/api/tests",
    "db:upgrade": ".venv/bin/alembic -c apps/api/alembic.ini upgrade head",
    "test:progress": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test apps/web/tests/progress.test.mjs",
    "api:dev": ".venv/bin/python apps/api/run_dev.py"
  }
}
